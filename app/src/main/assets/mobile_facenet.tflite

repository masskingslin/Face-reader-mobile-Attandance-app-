import tensorflow as tf
from tensorflow.keras import layers, models

def create_mobile_facenet():
    # Input shape: 112x112 RGB
    inputs = layers.Input(shape=(112, 112, 3), name="input_1")
    
    # Feature Extraction Backbone
    x = layers.Conv2D(64, kernel_size=3, strides=2, padding="same", use_bias=False)(inputs)
    x = layers.BatchNormalization()(x)
    x = layers.PReLU()(x)

    # Depthwise Separable Blocks
    x = layers.DepthwiseConv2D(kernel_size=3, strides=1, padding="same", use_bias=False)(x)
    x = layers.BatchNormalization()(x)
    x = layers.PReLU()(x)
    
    x = layers.Conv2D(64, kernel_size=1, strides=1, use_bias=False)(x)
    x = layers.BatchNormalization()(x)

    # Global Depthwise Output & 192-d Projection
    x = layers.GlobalAveragePooling2D()(x)
    x = layers.Dense(192, use_bias=False, name="embeddings")(x)
    outputs = layers.BatchNormalization()(x)

    model = models.Model(inputs=inputs, outputs=outputs, name="MobileFaceNet")
    return model

# 1. Build and convert model
model = create_mobile_facenet()
converter = tf.lite.TFLiteConverter.from_keras_model(model)
converter.optimizations = [tf.lite.Optimize.DEFAULT]
tflite_model = converter.convert()

# 2. Save file
with open("mobile_facenet.tflite", "wb") as f:
    f.write(tflite_model)

print("Saved mobile_facenet.tflite successfully (112x112x3 -> 192).")
